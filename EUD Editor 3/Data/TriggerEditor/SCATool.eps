                PlayWAV("sound\\Misc\\ZRescue.wav");
                f_eprintln("\x03SCArchive\x04 已连接到 \x07。");
            }
            if (IsUserCP()) {
                MSQCSpecial = 0;
            }
        }
        
        if (ml.loadstart[CP] != 0){
            ml.loadstart[CP] = 0;
        }
        ConnectionTime[CP] = 0;
    }




}

function Exec() {
    EUDPlayerLoop()();
    PlayerExec();
    EUDEndPlayerLoop();
}


function DataLoad(Slot) {
    const CP = getcurpl();

    if (ConnectStatus[CP] == 1) {
        if (SCACommand[CP] == 0) {
            DataSlot[CP] = Slot;
            BaseAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4;
            LoadAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4 + ((scf.SpaceLength + CommandLength) * (CP + 1)) / 4;


            LastTick = dwread_epd(EPD(0x51CE8C));

            SCALastMessage[CP] = 3;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\glue\\swishin.wav");
            }
            CheckIntegrityFlag[CP] = 0;
            MaxBuffer[CP] = scf.SpaceLength / 2;
            rn[CP] = 1;
            ack[CP] = 0;
            if (IsUserCP()) {
                MSQCValue = 0;
                index = 1;
            }
            SCACommand[CP] = 1;
            MSQCBuffer[CP] = 0;
        } else {
            SCALastMessage[CP] = 8;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\Misc\\PError.WAV");
                f_eprintln("\x08当前其他操作进行中。");
            }
        }
    } else {
        SCALastMessage[CP] = 7;
        if (SCAUseUserMessage == 1) {
            PlayWAV("sound\\Misc\\PError.WAV");
            f_eprintln("\x08要加载数据，必须连接到SCArchive。");
        }
    }
}


function DataSave(Slot) {
    const CP = getcurpl();

    if (ConnectStatus[CP] == 1) {
        if (SCACommand[CP] == 0) {
            DataSlot[CP] = Slot;
            BaseAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4;

            if (IsUserCP()) {
                SaveDataWrite();
            }

            MSQCBuffer[CP] = 0;
            SCALastMessage[CP] = 5;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\glue\\swishin.wav");
            }

            SCACommand[CP] = 4;
        } else {
            SCALastMessage[CP] = 8;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\Misc\\PError.WAV");
                f_eprintln("\x08当前其他操作进行中。");
            }
        }
    } else {
        SCALastMessage[CP] = 7;
        if (SCAUseUserMessage == 1) {
            PlayWAV("sound\\Misc\\PError.WAV");
            f_eprintln("\x08要保存数据，必须连接到SCArchive。");
        }
    }
}


/*
0 = 仅执行封禁
1 = 封禁后强制退出星际争霸
*/
function BanPlayer(BanType) {
    const CP = getcurpl();

    if (ConnectStatus[CP] == 1) {
        if (SCACommand[CP] == 0) {
            BaseAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4;

            SCALastMessage[CP] = 10;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\glue\\swishin.wav");
            }
            SCACommand[CP] = 5;
            const orderAddrEPD = EPD(scf.ws) + scf.EntryPointLength;

            if (IsUserCP()) {
                bwrite_epd(orderAddrEPD, 2, SCACommand[CP]);
                bwrite_epd(orderAddrEPD, 3, BanType);
            }


            MSQCBuffer[CP] = 0;
        } else {
            SCALastMessage[CP] = 8;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\Misc\\PError.WAV");
                f_eprintln("\x08当前其他操作进行中。");
            }
        }
    } else {
        SCALastMessage[CP] = 7;
        if (SCAUseUserMessage == 1) {
            PlayWAV("sound\\Misc\\PError.WAV");
            f_eprintln("\x08要执行命令，必须连接到SCArchive。");
        }
    }
}



function GetDate() {
    const CP = getcurpl();
    if (ConnectStatus[CP] == 1) {
        if (SCACommand[CP] == 0) {
            BaseAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4;
            LoadAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4 + ((scf.SpaceLength + CommandLength) * (CP + 1)) / 4;


            LastTick = dwread_epd(EPD(0x51CE8C));

            SCALastMessage[CP] = 3;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\glue\\swishin.wav");
            }
            CheckIntegrityFlag[CP] = 0;
            MaxBuffer[CP] = scf.SpaceLength / 2;
            rn[CP] = 1;
            ack[CP] = 0;
            if (IsUserCP()) {
                MSQCValue = 0;
                index = 1;
            }
            SCACommand[CP] = 2;
            MSQCBuffer[CP] = 0;
        } else {
            SCALastMessage[CP] = 8;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\Misc\\PError.WAV");
                f_eprintln("\x08当前其他操作进行中。");
            }
        }
    } else {
        SCALastMessage[CP] = 7;
        if (SCAUseUserMessage == 1) {
            PlayWAV("sound\\Misc\\PError.WAV");
            f_eprintln("\x08要加载数据，必须连接到SCArchive。");
        }
    }
}


function LoadGlobalData() {
    const CP = getcurpl();
    if (ConnectStatus[CP] == 1) {
        if (SCACommand[CP] == 0) {
            BaseAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4;
            LoadAddrEPD[CP] = EPD(scf.ws) + scf.EntryPointLength + CommandLength / 4 + ((scf.SpaceLength + CommandLength) * (CP + 1)) / 4;


            LastTick = dwread_epd(EPD(0x51CE8C));

            SCALastMessage[CP] = 3;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\glue\\swishin.wav");
            }
            CheckIntegrityFlag[CP] = 0;
            MaxBuffer[CP] = scf.SpaceLength / 2;
            rn[CP] = 1;
            ack[CP] = 0;
            if (IsUserCP()) {
                MSQCValue = 0;
                index = 1;
            }
            SCACommand[CP] = 3;
            MSQCBuffer[CP] = 0;
        } else {
            SCALastMessage[CP] = 8;
            if (SCAUseUserMessage == 1) {
                PlayWAV("sound\\Misc\\PError.WAV");
                f_eprintln("\x08当前其他操作进行中。");
            }
        }
    } else {
        SCALastMessage[CP] = 7;
        if (SCAUseUserMessage == 1) {
            PlayWAV("sound\\Misc\\PError.WAV");
            f_eprintln("\x08要加载数据，必须连接到SCArchive。");
        }
    }
}
