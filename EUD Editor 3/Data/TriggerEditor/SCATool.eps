                    }

                    if (IsUserCP()) {
                        SaveDataWrite();
                    }
                    bwrite_epd(orderAddrEPD, 3, 0);
                }
                if (MSQCBuffer[CP] == 100) {
                    if (IsUserCP()) {
                        bwrite_epd(orderAddrEPD, 2, 0);
                        bwrite_epd(orderAddrEPD, 3, 0);
                        MSQCValue = 0;
                        MSQCCondiction = 0;
                    }
                    SCACommand[CP] = 0;

                    SCALastMessage[CP] = 6;
                    if (SCAUseUserMessage == 1) {
                        PlayWAV("sound\\Misc\\TDrTra01.wav");
