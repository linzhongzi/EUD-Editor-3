/***
 * @Summary.ko-KR
 * 1 = 연결됨
 * 2 = 연결 끊킴
 * 3 = 로드중
 * 4 = 로드 완료
 * 5 = 세이브중
 * 6 = 세이브 완료
 * 7 = 런처와 먼저 연결하세요
 * 8 = 다른 작업 중입니다.
 * 9 = 작업 실패
 * 10 = 명령 실행
 * 11 = 시간 로드
 * 12 = 글로벌데이터 로드
 *
 * @Summary.en-US
 * 1 = Connected
 * 2 = Disconnected
 * 3 = Loading
 * 4 = Load complete
 * 5 = Saving
 * 6 = Save complete
 * 7 = Please connect to the launcher first
 * 8 = Another operation in progress
 * 9 = Operation failed
 * 10 = Command executed
 * 11 = Time loaded
 * 12 = Global data loaded
 *
 * @Summary.zh-CN
 * 1 = 已连接
 * 2 = 连接断开
 * 3 = 加载中
 * 4 = 加载完成
 * 5 = 保存中
 * 6 = 保存完成
 * 7 = 请先连接到启动器
 * 8 = 其他操作进行中
 * 9 = 操作失败
 * 10 = 执行命令
 * 11 = 加载时间
 * 12 = 加载全局数据
***/
function GetLastMessage(){
	return sct.SCALastMessage[getcurpl()];
}


function ResetLastMessage(){
	sct.SCALastMessage[getcurpl()] = 0;
}

function LoadTime(){
	sct.GetDate();
}
function GetTimeLoadMessage(){
	return sct.DateLoadStatus[getcurpl()];
}
function ResetDateTimeMessage(){
	sct.DateLoadStatus[getcurpl()] = 0;
}


function GetGlobalDataLoadMessage(){
	return sct.GlobalDataLoadStatus[getcurpl()];
}
function ResetGlobalDataLoadMessage(){
	sct.GlobalDataLoadStatus[getcurpl()] = 0;
}
function LoadGlobalData(){
	sct.LoadGlobalData();
}


/***
 * @Summary.ko-KR
 * 0 = 벤만 작동
 * 1 = 벤 이후 스타크래프트 강제종료
 *
 * @Summary.en-US
 * 0 = Ban only
 * 1 = Force close StarCraft after ban
 *
 * @Summary.zh-CN
 * 0 = 仅封禁
 * 1 = 封禁后强制退出星际争霸
***/
function BanPlayer(BanType){
	sct.BanPlayer(BanType);
}

function LoadData(Slot){
	sct.DataLoad(Slot);
}
function SaveData(Slot){
	sct.DataSave(Slot);
}

function LoadFastData(Player, Slot){
	scfl.DataFastLoad(Player, Slot);
}