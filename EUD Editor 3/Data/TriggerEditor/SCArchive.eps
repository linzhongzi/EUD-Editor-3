function Init(){
	scf.Init();
	sct.Init();
    scfl.Init();
}


function Exec(){
	// scf.Exec(); Unnecessary Exec(), d/t PluginVariable::EUDOnStart(Reg)
	sct.Exec();
	scs.Exec();
	
