}

// Warning: This function shouldn't be called under desync condition!
// modified from source: https://cafe.naver.com/edac/91196
function ScreenShake(x, y, tempLoc: TrgLocation) {
    // To prevent desync afterward, rand should run for everyone
    const randX, randY = rand(), rand();
    if (IsUserCP()) {
        const SCREEN_X, SCREEN_Y = 0x628448, 0x628470;
        const rX, rY = (randX % x) - x/2, (randY % y) - y/2;
        const screenX = dwread(SCREEN_X);
        const screenY = dwread(SCREEN_Y);
        VProc(list(rX, rY), list(
            rX.QueueAddTo(screenX),
            rY.QueueAddTo(screenY)
        ));
        setloc(tempLoc, screenX, screenY);
        CenterView(64);
        const chkt = GetChkTokenized();
        const dim = chkt.getsection("DIM");
        const mapX, mapY = b2i2(dim) * 16, b2i2(dim, 2) * 16;  // × 32 ÷ 2 (map center)
        addloc(tempLoc, mapX - dwread(SCREEN_X), mapY - dwread(SCREEN_Y));
        CenterView(tempLoc);
    }
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [player]의 [epd]를 부대 [hotkey]의 [slot]으로 지정합니다.
 * @param.player.ko-KR
 * 대상 플레이어입니다.
 * @param.epd.ko-KR
 * 지정할 유닛입니다.
 * @param.hotkey.ko-KR
 * 부대입니다.
 * @param.slot.ko-KR
 * 슬롯입니다.
 *
 * @Summary.en-US
 * Assigns [epd] of [player] to control group [hotkey] slot [slot].
 * @param.player.en-US
 * The target player.
 * @param.epd.en-US
 * The unit to assign.
 * @param.hotkey.en-US
 * The control group (hotkey).
 * @param.slot.en-US
 * The slot.
 *
 * @Summary.zh-CN
 * 将 [player] 的 [epd] 分配到编队 [hotkey] 的槽位 [slot]。
 * @param.player.zh-CN
 * 目标玩家。
 * @param.epd.zh-CN
 * 要分配的单位。
 * @param.hotkey.zh-CN
 * 编队（快捷键）。
 * @param.slot.zh-CN
 * 槽位。
***/
function hotkeyUnitEPD(epd, player: TrgPlayer, hotkey, slot) {
    epd += 0xA5 / 4;
    const tosread_epd = readgen_epd(0xFF00, list(0, py_eval('lambda x: 8*x')));
    const alphaID = tosread_epd(epd);
    if (epd == 19025 + 0xA5/4) {
        DoActions(alphaID.AddNumber(1));
    } else {
        const diff = 1701 - (161866 - epd) / 84;
        VProc(diff, diff.QueueAddTo(alphaID));
    }
    SetDeaths(EPD(0x57FE60) + 216 * player + slot, SetTo, alphaID, hotkey);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [player]의 [unitPTR]를 부대 [hotkey]의 [slot]으로 지정합니다.
 * @param.player.ko-KR
 * 대상 플레이어입니다.
 * @param.unitPTR.ko-KR
 * 지정할 유닛입니다.
 * @param.hotkey.ko-KR
 * 부대입니다.
 * @param.slot.ko-KR
 * 슬롯입니다.
 *
 * @Summary.en-US
 * Assigns [unitPTR] of [player] to control group [hotkey] slot [slot].
 * @param.player.en-US
 * The target player.
 * @param.unitPTR.en-US
 * The unit to assign.
 * @param.hotkey.en-US
 * The control group (hotkey).
 * @param.slot.en-US
 * The slot.
 *
 * @Summary.zh-CN
 * 将 [player] 的 [unitPTR] 分配到编队 [hotkey] 的槽位 [slot]。
 * @param.player.zh-CN
 * 目标玩家。
 * @param.unitPTR.zh-CN
 * 要分配的单位。
 * @param.hotkey.zh-CN
 * 编队（快捷键）。
 * @param.slot.zh-CN
 * 槽位。
***/
function hotkeyUnit(unitPTR, player: TrgPlayer, hotkey, slot) {
    hotkeyUnitEPD(EPD(unitPTR), player, hotkey, slot);
}

function __GetLocCoord(loc: TrgLocation) {
    const loc_epd = loc * 5;
    DoActions(loc_epd.AddNumber(EPD(0x58DC4C)));
    const x1 = dwread_epd(loc_epd);
    DoActions(loc_epd.AddNumber(1));
    const y1 = dwread_epd(loc_epd);
    DoActions(loc_epd.AddNumber(1));
    const x2 = dwread_epd(loc_epd);
    DoActions(loc_epd.AddNumber(1));
    const y2 = dwread_epd(loc_epd);
    return x1, y1, x2, y2;
}

/***
 * @Type
 * F
 * @Summary.ko-KR
 * [originLoc]로부터 [destLoc]의 동경을 구합니다.
 * @param.originLoc.ko-KR
 * 대상 로케이션입니다.
 * @param.destLoc.ko-KR
 * 각도를 구할 목표 로케이션입니다.
 *
 * @Summary.en-US
 * Returns the bearing angle from [originLoc] to [destLoc].
 * @param.originLoc.en-US
 * The source location.
 * @param.destLoc.en-US
 * The destination location.
 *
 * @Summary.zh-CN
 * 返回从 [originLoc] 到 [destLoc] 的方位角。
 * @param.originLoc.zh-CN
 * 源位置。
 * @param.destLoc.zh-CN
 * 目标位置。
***/
function LocationAngle(originLoc: TrgLocation, destLoc: TrgLocation) {
    const ox1, oy1, ox2, oy2 = __GetLocCoord(originLoc);
    const dx1, dy1, dx2, dy2 = __GetLocCoord(destLoc);
    const x1 = ox1 + ox2;
    const y1 = oy1 + oy2;
    const x2 = dx1 + dx2;
    const y2 = dy1 + dy2;
    return atan2(x2 - x1, y1 - y2);
}

// GetAngle and LocationAngle functions are duplicates..
// GetAngle과 LocationAngle 함수는 중복됩니다..
function GetAngle(originLoc: TrgLocation, destLoc: TrgLocation) {
    return LocationAngle(originLoc, destLoc);
}

/***
 * @Type
 * F
 * @Summary.ko-KR
 * [loc1]로부터 [loc2]가 떨어진 거리를 구합니다.
 * @param.loc1.ko-KR
 * 대상 로케이션입니다.
 * @param.loc2.ko-KR
 * 거리를 구할 목표 로케이션입니다.
 *
 * @Summary.en-US
 * Returns the distance between [loc1] and [loc2].
 * @param.loc1.en-US
 * The first location.
 * @param.loc2.en-US
 * The second location.
 *
 * @Summary.zh-CN
 * 返回 [loc1] 与 [loc2] 之间的距离。
 * @param.loc1.zh-CN
 * 第一个位置。
 * @param.loc2.zh-CN
 * 第二个位置。
***/
function LocationDistance(loc1: TrgLocation, loc2: TrgLocation) {
    const ox1, oy1, ox2, oy2 = __GetLocCoord(loc1);
    const dx1, dy1, dx2, dy2 = __GetLocCoord(loc2);
    const x = dx1 + dx2 - (ox1 + ox2);
    const y = dy1 + dy2 - (oy1 + oy2);
    return sqrt(x*x + y*y) / 2;
}

// LocationDistanceVal actually hasn't written to variable in EE2 TE.
function LocationDistanceVal(variable, loc1: TrgLocation, loc2: TrgLocation) {
    return LocationDistance(loc1, loc2);
}


/***
 * @Type
 * F
 * @Summary.ko-KR
 * [x1], [y1]로부터 [x2], [y2]가 떨어진 거리를 구합니다.
 * @param.x1.ko-KR
 * x좌표1
 * @param.x2.ko-KR
 * x좌표2
 * @param.y1.ko-KR
 * y좌표1
 * @param.y2.ko-KR
 * y좌표2
 *
 * @Summary.en-US
 * Returns the distance between ([x1], [y1]) and ([x2], [y2]).
 * @param.x1.en-US
 * X coordinate 1
 * @param.x2.en-US
 * X coordinate 2
 * @param.y1.en-US
 * Y coordinate 1
 * @param.y2.en-US
 * Y coordinate 2
 *
 * @Summary.zh-CN
 * 返回点 ([x1], [y1]) 与 ([x2], [y2]) 之间的距离。
 * @param.x1.zh-CN
 * X 坐标 1
 * @param.x2.zh-CN
 * X 坐标 2
 * @param.y1.zh-CN
 * Y 坐标 1
 * @param.y2.zh-CN
 * Y 坐标 2
***/
function Distance(x1, y1, x2, y2) {
    const x = x2 - x1;
    const y = y2 - y1;
    return sqrt(x*x + y*y);
}



/***
 * @Type
 * A
 * @Summary.ko-KR
 * [loc]를 [lenght]만큼 [angle]각도로 이동시킵니다.
 * @param.loc.ko-KR
 * 이동할 로케이션입니다.
 * @param.length.ko-KR
 * 움직일 거리입니다.
 * @param.angle.ko-KR
 * 이동할 각도입니다.
 *
 * @Summary.en-US
 * Moves [loc] by [length] at [angle] degrees.
 * @param.loc.en-US
 * The location to move.
 * @param.length.en-US
 * The distance to move.
 * @param.angle.en-US
 * The angle to move.
 *
 * @Summary.zh-CN
 * 将 [loc] 沿 [angle] 方向移动 [length] 距离。
 * @param.loc.zh-CN
 * 要移动的位置。
 * @param.length.zh-CN
 * 移动的距离。
 * @param.angle.zh-CN
 * 移动的角度。
***/
function PolarLocation(loc: TrgLocation, length, angle) {
    const x, y = lengthdir(length, angle);
    addloc(loc, x, y);
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitLoc][unitEPD]가 범위 [range]안에서 지면에 [targetLoc][skillOrder]을 사용한 것을 감지합니다.
 * @param.unitLoc.ko-KR
 * 스킬을 사용한 유닛에게 부착될 로케이션입니다.
 * @param.unitEPD.ko-KR
 * 스킬을 사용할 유닛입니다.
 * @param.range.ko-KR
 * 스킬을 감지할 범위입니다.
 * @param.targetLoc.ko-KR
 * 스킬이 타격될 위치에 부착될 로케이션입니다.
 * @param.skillOrder.ko-KR
 * 감지할 스킬입니다.
 *
 * @Summary.en-US
 * Detects when [unitEPD] uses [skillOrder] on the ground within [range] and stores the impact location in [targetLoc].
 * @param.unitLoc.en-US
 * Location to attach to the unit that used the skill.
 * @param.unitEPD.en-US
 * The unit that uses the skill.
 * @param.range.en-US
 * The detection range.
 * @param.targetLoc.en-US
 * Location to attach to the impact position.
 * @param.skillOrder.en-US
 * The skill order to detect.
 *
 * @Summary.zh-CN
 * 检测 [unitEPD] 在 [range] 范围内对地面使用 [skillOrder] 技能，
 * 并将 [unitLoc] 附加到施法单位的位置，将 [targetLoc] 附加到技能命中位置。
 * @param.unitLoc.zh-CN
 * 要附加到施法单位上的位置。
 * @param.unitEPD.zh-CN
 * 使用技能的单位。
 * @param.range.zh-CN
 * 检测范围。
 * @param.targetLoc.zh-CN
 * 要附加到技能命中位置上的坐标。
 * @param.skillOrder.zh-CN
 * 要检测的技能命令。
***/
function CheckNoneTargetSkillEPD(
    unitEPD,
    range,
    unitLoc: TrgLocation,
    targetLoc: TrgLocation,
    skillOrder /*Order*/
) {
    unitEPD += 0x4D/4;
    if (MemoryXEPD(unitEPD, Exactly, skillOrder * 256, 0xFF00)) {
        unitEPD += -((0x4D - 0x28)/4);
        const x, y = posread_epd(unitEPD);
        setloc(unitLoc, x, y);
        unitEPD += (0x58 - 0x28)/4;
        setloc_epd(targetLoc, unitEPD);

        if (range > LocationDistance(unitLoc, targetLoc)) {
            MoveLocation(targetLoc, 227, AllPlayers, targetLoc);
            unitEPD += -((0x58 - 0x4C)/4);
            SetMemoryXEPD(unitEPD, SetTo, 0x100, 0xFF00);
            unitEPD += -((0x4D - 0x10)/4);
            SetMemoryEPD(unitEPD, SetTo, x + y * 65536);
            return True;
        }
    }
    return False;
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitLoc][unitPTR]가 범위 [range]안에서 지면에 [targetLoc][skillOrder]을 사용한 것을 감지합니다.
 * @param.unitLoc.ko-KR
 * 스킬을 사용한 유닛에게 부착될 로케이션입니다.
 * @param.unitPTR.ko-KR
 * 스킬을 사용할 유닛입니다.
 * @param.range.ko-KR
 * 스킬을 감지할 범위입니다.
 * @param.targetLoc.ko-KR
 * 스킬이 타격될 위치에 부착될 로케이션입니다.
 * @param.skillOrder.ko-KR
 * 감지할 스킬입니다.
 *
 * @Summary.en-US
 * Detects when [unitPTR] uses [skillOrder] on the ground within [range] and stores the impact location in [targetLoc].
 * @param.unitLoc.en-US
 * Location to attach to the unit that used the skill.
 * @param.unitPTR.en-US
 * The unit that uses the skill.
 * @param.range.en-US
 * The detection range.
 * @param.targetLoc.en-US
 * Location to attach to the impact position.
 * @param.skillOrder.en-US
 * The skill order to detect.
 *
 * @Summary.zh-CN
 * 检测 [unitPTR] 在 [range] 范围内对地面使用 [skillOrder] 技能，
 * 并将 [unitLoc] 附加到施法单位的位置，将 [targetLoc] 附加到技能命中位置。
 * @param.unitLoc.zh-CN
 * 附加到使用技能的单位上的位置。
 * @param.unitPTR.zh-CN
 * 使用技能的单位。
 * @param.range.zh-CN
 * 检测范围。
 * @param.targetLoc.zh-CN
 * 附加到命中地点的坐标位置。
 * @param.skillOrder.zh-CN
 * 要检测的技能命令。
***/
function CheckNoneTargetSkill(
    unitPTR,
    range,
    unitLoc: TrgLocation,
    targetLoc: TrgLocation,
    skillOrder /*Order*/
) {
    return CheckNoneTargetSkillEPD(
        EPD(unitPTR),
        range,
        unitLoc,
        targetLoc,
        skillOrder /*Order*/
    );
}



/***
 * @Type
 * A
 * @Summary.ko-KR
 * [location]을 [unitEPD]에게 구조오프셋 [posX]으로 부착합니다.
 * @param.location.ko-KR
 * 유닛에게 부착될 로케이션입니다.
 * @param.unitEPD.ko-KR
 * 대상 유닛입니다.
 * @param.posX.ko-KR
 * 부착될 위치를 결정하는 구조오프셋입니다.
 *
 * @Summary.en-US
 * Attaches [location] to [unitEPD] using struct offset [posX].
 * @param.location.en-US
 * The location to attach to the unit.
 * @param.unitEPD.en-US
 * The target unit.
 * @param.posX.en-US
 * Struct offset that determines the attachment position.
 *
 * @Summary.zh-CN
 * 使用结构偏移 [posX] 将 [location] 附加到 [unitEPD]。
 * @param.location.zh-CN
 * 要附加到单位上的位置。
 * @param.unitEPD.zh-CN
 * 目标单位。
 * @param.posX.zh-CN
 * 决定附加位置的结构偏移。
***/
function SetLocationToUnitSafeEPD(location: TrgLocation, unitEPD, posX) {
    unitEPD += posX/4;
    setloc_epd(location, unitEPD);
}


/***
 * @Type
 * A
 * @Summary.ko-KR
 * [location]을 [unitPTR]에게 구조오프셋 [posX]으로 부착합니다.
 * @param.location.ko-KR
 * 유닛에게 부착될 로케이션입니다.
 * @param.unitPTR.ko-KR
 * 대상 유닛입니다.
 * @param.posX.ko-KR
 * 부착될 위치를 결정하는 구조오프셋입니다.
 *
 * @Summary.en-US
 * Attaches [location] to [unitPTR] using struct offset [posX].
 * @param.location.en-US
 * The location to attach to the unit.
 * @param.unitPTR.en-US
 * The target unit.
 * @param.posX.en-US
 * Struct offset that determines the attachment position.
 *
 * @Summary.zh-CN
 * 使用结构偏移 [posX] 将 [location] 附加到 [unitPTR]。
 * @param.location.zh-CN
 * 要附加到单位上的位置。
 * @param.unitPTR.zh-CN
 * 目标单位。
 * @param.posX.zh-CN
 * 决定附加位置的结构偏移。
***/
function SetLocationToUnitSafe(location: TrgLocation, unitPTR, posX) {
    SetLocationToUnitSafeEPD(location, EPD(unitPTR), posX);
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitLoc][unitEPD]가 범위 [range]안에서 일정한 대상에게 [targetLoc][skillOrder]을 사용한 것을 감지합니다.
 * @param.unitLoc.ko-KR
 * 스킬을 사용한 유닛에게 부착될 로케이션입니다.
 * @param.unitEPD.ko-KR
 * 스킬을 사용할 유닛입니다.
 * @param.range.ko-KR
 * 스킬을 감지할 범위입니다.
 * @param.targetLoc.ko-KR
 * 스킬이 타격될 위치에 부착될 로케이션입니다.
 * @param.skillOrder.ko-KR
 * 감지할 스킬입니다.
 *
 * @Summary.en-US
 * Detects when [unitEPD] uses [skillOrder] on a specific target within [range] and stores the target location in [targetLoc].
 * @param.unitLoc.en-US
 * Location to attach to the unit that used the skill.
 * @param.unitEPD.en-US
 * The unit that uses the skill.
 * @param.range.en-US
 * The detection range.
 * @param.targetLoc.en-US
 * Location to attach to the impact position.
 * @param.skillOrder.en-US
 * The skill order to detect.
 *
 * @Summary.zh-CN
 * 检测 [unitEPD] 在 [range] 范围内对地面使用 [skillOrder] 技能，
 * 并将 [unitLoc] 附加到施法单位的位置，将 [targetLoc] 附加到技能命中位置。
 * @param.unitLoc.zh-CN
 * 附加到使用技能的单位上的位置。
 * @param.unitEPD.zh-CN
 * 使用技能的单位。
 * @param.range.zh-CN
 * 检测范围。
 * @param.targetLoc.zh-CN
 * 附加到命中地点的坐标位置。
 * @param.skillOrder.zh-CN
 * 要检测的技能命令。
***/
function CheckTargetSkillEPD(
    unitEPD,
    range,
    unitLoc: TrgLocation,
    targetLoc: TrgLocation,
    skillOrder
) {
    unitEPD += 19;  // 0x4D orderID
    if (MemoryXEPD(unitEPD, Exactly, skillOrder * 256, 0xFF00)) {
        unitEPD += 4;  // 0x5C orderTargetUnit
        if (MemoryEPD(unitEPD, Exactly, 0)) return False;
        unitEPD -= 1;  // 0x58 orderTargetPos
        const tx, ty = posread_epd(unitEPD);
        unitEPD -= 12;  // 0x28 position
        const x, y = posread_epd(unitEPD);
        const dx, dy = tx - x, ty - y;
        if (dx*dx + dy*dy < range*range) {
            setloc(unitLoc, x, y);
            setloc(targetLoc, tx, ty);
            DoActions(list(
                unitEPD.SubtractNumber(6),  // 0x10 moveTarget
                RemoveUnitAt(1, 101, 255, P9),
            ));
            SetMemoryEPD(unitEPD, SetTo, x + y * 65536);
            //unitEPD += 9;  // 0x4D orderID
            unitEPD += 15;  // 0x4D orderID
            SetMemoryXEPD(unitEPD, SetTo, 0x100, 0xFF00);
            return True;
        }
    }
    return False;
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitLoc][unitPTR]가 범위 [range]안에서 일정한 대상에게 [targetLoc][skillOrder]을 사용한 것을 감지합니다.
 * @param.unitLoc.ko-KR
 * 스킬을 사용한 유닛에게 부착될 로케이션입니다.
 * @param.unitPTR.ko-KR
 * 스킬을 사용할 유닛입니다.
 * @param.range.ko-KR
