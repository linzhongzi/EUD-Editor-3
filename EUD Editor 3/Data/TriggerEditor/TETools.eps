 * The skill order to detect.
 *
 * @Summary.zh-CN
 * 检测 [unitPTR] 在 [range] 范围内对地面使用 [skillOrder] 技能，
 * 并将 [unitLoc] 附加到施法单位的位置，将 [targetLoc] 附加到技能命中位置。
 * @param.unitLoc.zh-CN
 * 附加到使用技能的单位上的位置。
 * @param.unitPTR.zh-CN
 * 使用技能的单位。
 * @param.range.zh-CN
 * 检测范围。
 * @param.targetLoc.zh-CN
 * 附加到命中地点的坐标位置。
 * @param.skillOrder.zh-CN
 * 要检测的技能命令。
***/
function CheckTargetSkill(
    unitPTR,
    range,
    unitLoc: TrgLocation,
    targetLoc: TrgLocation,
    skillOrder
) {
    return CheckTargetSkillEPD(EPD(unitPTR), range, unitLoc, targetLoc, skillOrder);
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitEPD]가 [location]에 존재하는지 판단합니다. [dummyUnit]
 * @param.unitEPD.ko-KR
 * 대상 유닛입니다.
 * @param.location.ko-KR
 * 대상 로케이션입니다.
 * @param.dummyUnit.ko-KR
 * Bring을 위해 잠시 변경할 유닛ID입니다. 사용하지 않는 UnitID를 사용하세요.
 *
 * @Summary.en-US
 * Determines whether [unitEPD] exists in [location]. Uses [dummyUnit].
 * @param.unitEPD.en-US
 * The target unit.
 * @param.location.en-US
 * The target location.
 * @param.dummyUnit.en-US
 * Temporary unit ID used for Bring. Use an unused UnitID.
 *
 * @Summary.zh-CN
 * 判断 [unitEPD] 是否存在于 [location] 中。使用 [dummyUnit]。
 * @param.unitEPD.zh-CN
 * 目标单位。
 * @param.location.zh-CN
 * 目标位置。
 * @param.dummyUnit.zh-CN
 * 临时用于 Bring 的单位 ID。请使用未使用的 UnitID。
***/
function CBringEPD(unitEPD, location: TrgLocation, dummyUnit: TrgUnit) {
    MoveLocation(location, dummyUnit, AllPlayers, location);
    const unitType = unitEPD + 0x64/4;
    const originalUnitType = wread_epd(unitType, 0);
    SetMemoryXEPD(unitType, SetTo, dummyUnit, 0xFFFF);
    const ret = l2v(Bring(AllPlayers, AtLeast, 1, dummyUnit, location));
    SetMemoryXEPD(unitType, SetTo, originalUnitType, 0xFFFF);
    return ret;
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitPTR]가 [location]에 존재하는지 판단합니다. [dummyUnit]
 * @param.unitPTR.ko-KR
 * 대상 유닛입니다.
 * @param.location.ko-KR
 * 대상 로케이션입니다.
 * @param.dummyUnit.ko-KR
 * Bring을 위해 잠시 변경할 유닛ID입니다. 사용하지 않는 UnitID를 사용하세요.
 *
 * @Summary.en-US
 * Determines whether [unitPTR] exists in [location]. Uses [dummyUnit].
 * @param.unitPTR.en-US
 * The target unit.
 * @param.location.en-US
 * The target location.
 * @param.dummyUnit.en-US
 * Temporary unit ID used for Bring. Use an unused UnitID.
 *
 * @Summary.zh-CN
 * 判断 [unitPTR] 是否存在于 [location] 中。使用 [dummyUnit]。
 * @param.unitPTR.zh-CN
 * 目标单位。
 * @param.location.zh-CN
 * 目标位置。
 * @param.dummyUnit.zh-CN
 * 临时用于 Bring 的单位 ID。请使用未使用的 UnitID。
***/
function CBring(unitPTR, location: TrgLocation, dummyUnit: TrgUnit) {
    return CBringEPD(EPD(unitPTR), location, dummyUnit);
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitEPD]의 생산대기열을 초기화합니다.
 * @param.unitEPD.ko-KR
 * 대상 유닛입니다.
 *
 * @Summary.en-US
 * Resets the production queue of [unitEPD].
 * @param.unitEPD.en-US
 * The target unit.
 *
 * @Summary.zh-CN
 * 重置 [unitEPD] 的生产队列。
 * @param.unitEPD.zh-CN
 * 目标单位。
***/
function BuildResetEPD(unitEPD) {
    VProc(unitEPD, list(
        unitEPD.AddNumber(0x98/4),
        unitEPD.SetDest(EPD(0x6509B0)),
    ));
    setcurpl2cpcache(actions=list(
        SetDeaths(CurrentPlayer, SetTo, 0xE400E4, 0),
        SetMemory(0x6509B0, Add, 1),
        SetDeaths(CurrentPlayer, SetTo, 0xE400E4, 0),
        SetMemory(0x6509B0, Add, 1),
        SetDeathsX(CurrentPlayer, SetTo, 228, 0, 0xFFFF),
        SetMemory(0x6509B0, Add, 1),
        SetDeathsX(CurrentPlayer, SetTo, 2 << 16, 0, 0xFFFF0000),
    ));
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitPTR]의 생산대기열을 초기화합니다.
 * @param.unitPTR.ko-KR
 * 대상 유닛입니다.
 *
 * @Summary.en-US
 * Resets the production queue of [unitPTR].
 * @param.unitPTR.en-US
 * The target unit.
 *
 * @Summary.zh-CN
 * 重置 [unitPTR] 的生产队列。
 * @param.unitPTR.zh-CN
 * 目标单位。
***/
function BuildReset(unitPTR) {
    BuildResetEPD(EPD(unitPTR));
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitEPD]가 [unit]을 생산중인지 확인합니다..
 * @param.unitEPD.ko-KR
 * 대상 유닛입니다.
 * @param.unit.ko-KR
 * 확인할 유닛입니다.
 *
 * @Summary.en-US
 * Checks whether [unitEPD] is producing [unit].
 * @param.unitEPD.en-US
 * The target unit.
 * @param.unit.en-US
 * The unit to check.
 *
 * @Summary.zh-CN
 * 检查 [unitEPD] 是否正在生产 [unit]。
 * @param.unitEPD.zh-CN
 * 目标单位。
 * @param.unit.zh-CN
 * 要检查的单位。
***/
function BuildCheckEPD(unitEPD, unit: TrgUnit) {
    unitEPD += 0x98 / 4;  // buildQueue
    if (MemoryXEPD(unitEPD, Exactly, unit, 0xFFFF)) {
        return True;
    } else {
        const mulUnit = unit * 65536;
        if (MemoryXEPD(unitEPD, Exactly, mulUnit, 0xFFFF0000)) {
            return True;
        } else {
            unitEPD += 1;
            if (MemoryXEPD(unitEPD, Exactly, unit, 0xFFFF)) {
                return True;
            } else if (MemoryXEPD(unitEPD, Exactly, mulUnit, 0xFFFF0000)) {
                return True;
            } else {
                unitEPD += 1;
                if (MemoryXEPD(unitEPD, Exactly, unit, 0xFFFF)) {
                    return True;
                }
            }
        }
    }
    return False;
}

/***
 * @Type
 * C
 * @Summary.ko-KR
 * [unitPTR]가 [unit]을 생산중인지 확인합니다..
 * @param.unitPTR.ko-KR
 * 대상 유닛입니다.
 * @param.unit.ko-KR
 * 확인할 유닛입니다.
 *
 * @Summary.en-US
 * Checks whether [unitPTR] is producing [unit].
 * @param.unitPTR.en-US
 * The target unit.
 * @param.unit.en-US
 * The unit to check.
 *
 * @Summary.zh-CN
 * 检查 [unitPTR] 是否正在生产 [unit]。
 * @param.unitPTR.zh-CN
 * 目标单位。
 * @param.unit.zh-CN
 * 要检查的单位。
***/
function BuildCheck(unitPTR, unit: TrgUnit) {
    return BuildCheckEPD(EPD(unitPTR), unit);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [player]의 [attackLoc]에서 [attackUnit]이 생산되어 [targetLoc]에서 생산된 [targetUnit]을 공격합니다.
 * @param.player.ko-KR
 * 대상 플레이어입니다.
 * @param.attackLoc.ko-KR
 * 공격 유닛이 생산될 로케이션입니다.
 * @param.targetLoc.ko-KR
 * 피격 유닛이 생산될 로케이션입니다.
 * @param.attackUnit.ko-KR
 * 공격 유닛입니다.
 * @param.targetUnit.ko-KR
 * 피격 유닛입니다.
 *
 * @Summary.en-US
 * Spawns [attackUnit] at [attackLoc] for [player] and attacks [targetUnit] spawned at [targetLoc].
 * @param.player.en-US
 * The target player.
 * @param.attackLoc.en-US
 * The location where the attacking unit will be spawned.
 * @param.targetLoc.en-US
 * The location where the target unit will be spawned.
 * @param.attackUnit.en-US
 * The attacking unit.
 * @param.targetUnit.en-US
 * The target unit.
 *
 * @Summary.zh-CN
 * 在 [attackLoc] 为 [player] 生成 [attackUnit]，并攻击在 [targetLoc] 生成的 [targetUnit]。
 * @param.player.zh-CN
 * 目标玩家。
 * @param.attackLoc.zh-CN
 * 攻击单位生成的位置。
 * @param.targetLoc.zh-CN
 * 被攻击单位生成的位置。
 * @param.attackUnit.zh-CN
 * 攻击单位。
 * @param.targetUnit.zh-CN
 * 目标单位。
***/
function AttackGround(
    attackLoc: TrgLocation,
    targetLoc: TrgLocation,
    attackUnit: TrgUnit,
    targetUnit: TrgUnit,
    player: TrgPlayer
) {
    if (Memory(0x628438, Exactly, 0)) return;  // avoid EUDError when CCMU
    const aUnit = cunitepdread_epd(EPD(0x628438))[[1]];
    CreateUnit(1, attackUnit, attackLoc, player);
    DoActions(aUnit.AddNumber(0x110 / 4));
    SetMemoryEPD(aUnit, Add, 2);  // aUnit + 0x110 (CUnit::removeTimer)

    if (Memory(0x628438, Exactly, 0)) return;  // avoid EUDError when CCMU
    const tunitptr, tunit = cunitepdread_epd(EPD(0x628438));
    CreateUnit(1, targetUnit, targetLoc, player);
    DoActions(list(
        tunit.AddNumber(0x110 / 4),
        aUnit.AddNumber(-((0x110 - 0x5C) / 4))
    ));
    SetMemoryEPD(aUnit, SetTo, tunitptr);  // aUnit + 0x5C (CUnit::targetUnit)
    SetMemoryEPD(tunit, Add, 2);  // tunit + 0x110 (CUnit::removeTimer)

    DoActions(aUnit.AddNumber(-((0x5C - 0x4C) / 4)));
    SetMemoryXEPD(aUnit, SetTo, 0xA00, 0xFF00);  // order[10]=attack, 0x4D (CUnit::order)
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [epd]의 상태 [flags]를 활성화합니다.
 * @param.epd.ko-KR
 * 대상 유닛입니다.
 * @param.flags.ko-KR
 * 활성화할 상태입니다.
 *
 * @Summary.en-US
 * Adds status [flags] to [epd].
 * @param.epd.en-US
 * The target unit.
 * @param.flags.en-US
 * The status flags to add.
 *
 * @Summary.zh-CN
 * 激活[epd]的状态[flags]。

 * @param.epd.zh-CN
 * 目标单位。
 * @param.flags.zh-CN
 * 要激活的状态。
***/
function AddStatusFlagsEPD(epd, flags /*StatusFlags*/) {
    epd += 0xDC / 4;
    SetMemoryXEPD(epd, SetTo, ~0, flags);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [unitPTR]의 상태 [flags]를 활성화합니다.
 * @param.unitPTR.ko-KR
 * 대상 유닛입니다.
 * @param.flags.ko-KR
 * 활성화할 상태입니다.
 *
 * @Summary.en-US
 * Adds status [flags] to [unitPTR].
 * @param.unitPTR.en-US
 * The target unit.
 * @param.flags.en-US
 * The status flags to add.
 *
 * @Summary.zh-CN
 * 激活[unitPTR]的状态[flags]。

 * @param.unitPTR.zh-CN
 * 目标单位。
 * @param.flags.zh-CN
 * 要激活的状态。
***/
function AddStatusFlags(unitPTR, flags /*StatusFlags*/) {
    unitPTR += 0xDC;
    SetMemoryX(unitPTR, SetTo, ~0, flags);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [location]의 넓이를 ([width], [height])만큼 넓힙니다.
 * @param.location.ko-KR
 * 대상 로케이션입니다.
 * @param.width.ko-KR
 * 늘어날 넓이입니다.
 * @param.height.ko-KR
 * 늘어날 높이입니다.
 *
 * @Summary.en-US
 * Expands [location] by ([width], [height]).
 * @param.location.en-US
 * The target location.
 * @param.width.en-US
 * The width to expand.
 * @param.height.en-US
 * The height to expand.
 *
 * @Summary.zh-CN
 * 将 [location] 的尺寸扩大 ([width], [height])。
 * @param.location.zh-CN
 * 目标位置。
 * @param.width.zh-CN
 * 要增加的宽度。
 * @param.height.zh-CN
 * 要增加的高度。
***/
function AddSizeLocation(location: TrgLocation, width, height) {
    dilateloc(location, width, height);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [ptr]의 소유권을 [NewOwner]에게 넘깁니다..
 * @param.ptr.ko-KR
 * 유닛의 포인터입니다.
 * @param.NewOwner.ko-KR
 * 플레이어 입니다.
 *
 * @Summary.en-US
 * Transfers ownership of [ptr] to [NewOwner].
 * @param.ptr.en-US
 * The unit pointer.
 * @param.NewOwner.en-US
 * The new owner player.
 *
 * @Summary.zh-CN
 * 将 [ptr] 的所有权转让给 [NewOwner]。
 * @param.ptr.zh-CN
 * 单位的指针。
 * @param.NewOwner.zh-CN
 * 新的所有者玩家。
***/
function CGive(ptr ,NewOwner: TrgPlayer) {
    const epd = EPD(ptr);
    const player = epd + 0x4C / 4;
    const Owner = bread_epd(player, 0);
    SetMemoryXEPD(player, SetTo, NewOwner, 0xFF);
    const prv, nxt = epd + 0x68 / 4, epd + 0x6C / 4;
    const prev_ptr, prev_epd = cunitepdread_epd(prv);
    const next_ptr, next_epd = cunitepdread_epd(nxt);
    if(prev_ptr >= 0x59CCA8) {
        dwwrite_epd(prev_epd + 0x6C / 4, next_ptr);
    } else {
        dwwrite_epd(EPD(0x6283F8) + Owner, next_ptr);
    }
    if(next_ptr >= 0x59CCA8) {
        dwwrite_epd(next_epd + 0x68 / 4, prev_ptr);
    }
    const NewHeader = EPD(0x6283F8) + NewOwner;
    if(MemoryEPD(NewHeader, AtLeast, 0x59CCA8)) {
        const NewPrevPtr, NewPrevEPD = cunitepdread_epd(NewHeader);
        const NewPrev_nxt = NewPrevEPD + 0x6C / 4;
        const NewNextPtr, NewNextEPD = cunitepdread_epd(NewPrev_nxt);
        dwwrite_epd(NewPrev_nxt, ptr);
        dwwrite_epd(prv, NewPrevPtr);
        dwwrite_epd(nxt, NewNextPtr);
        if(NewNextPtr >= 0x59CCA8) {
            dwwrite_epd(NewNextEPD + 0x68 / 4, ptr);
        }
    } else {
        dwwrite_epd(NewHeader, ptr);
        dwwrite_epd(prv, 0);
        dwwrite_epd(nxt, 0);
    }
}