 * @Summary.en-US
 * Changes the color of [epd] to [color].
 * @param.epd.en-US
 * The target unit.
 * @param.color.en-US
 * The color to change to.
 *
 * @Summary.zh-CN
 * 将 [epd] 的颜色改为 [color]。
 * @param.epd.zh-CN
 * 目标单位。
 * @param.color.zh-CN
 * 要更改的颜色。
***/
function SetUnitColorEPD(epd, color) {
    epd += 0x0C/4;
    const sprite = epdread_epd(epd);
    DoActions(sprite.AddNumber(0x0A/4));
    SetMemoryXEPD(sprite, SetTo, color * 65536, 0xFF0000);
}

