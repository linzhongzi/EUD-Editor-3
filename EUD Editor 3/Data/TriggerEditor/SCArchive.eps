}

function ExecFastLoad(){
	scfl.Exec();
}


function SetUseDefaultMessage(value){
	// 如果value为1则使用默认值
	sct.SCAUseUserMessage = value;
}

/***
 * @Summary.ko-KR
 * 0 = 연결끊킴
 * 1 = 연결됨
 *
 * @Summary.en-US
 * 0 = Disconnected
 * 1 = Connected
 *
 * @Summary.zh-CN
 * 0 = 连接断开
 * 1 = 已连接
***/
function ConnectStatus(){
	return sct.ConnectStatus[getcurpl()];
}

/***
 * @Summary.ko-KR
 * 0 = 대기
 * 1 = 불러오는 중
 * 2 = 시간 불러오는 중
 * 3 = 맵 변수 불러오는 중
 * 4 = 저장중
 *
 * @Summary.en-US
 * 0 = Waiting
 * 1 = Loading
 * 2 = Loading time
 * 3 = Loading map variables
 * 4 = Saving
 *
 * @Summary.zh-CN
 * 0 = 等待
 * 1 = 加载中
 * 2 = 时间加载中
 * 3 = 地图变量加载中
 * 4 = 保存中
***/
function CommandStatus(){
	return sct.SCACommand[getcurpl()];
}

function ConnectionTime(){
	return sct.ConnectionTime[getcurpl()];
}

