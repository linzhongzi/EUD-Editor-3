 * Sets the position of [location] to ([X], [Y]) and size to [width] x [height].
 * @param.location.en-US
 * The location to set.
 * @param.X.en-US
 * X coordinate.
 * @param.Y.en-US
 * Y coordinate.
 * @param.width.en-US
 * Width.
 * @param.height.en-US
 * Height.
 *
 * @Summary.zh-CN
 * 将 [location] 的坐标设置为 ([X], [Y])，大小设置为 [width] x [height]。
 * @param.location.zh-CN
 * 要设置的位置。
 * @param.X.zh-CN
 * X 坐标。
 * @param.Y.zh-CN
 * Y 坐标。
 * @param.width.zh-CN
 * 宽度。
 * @param.height.zh-CN
 * 高度。
***/
function SetLocation(location: TrgLocation, X, Y, width, height) {
    setloc(location, X, Y);
    dilateloc(location, width/2, height/2);
}

/***
 * @Type
 * A
 * @Summary.ko-KR
 * [Location]의 좌표를 ([X], [Y])만큼 평행이동합니다.
