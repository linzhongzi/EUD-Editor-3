 * [epd]를 [newUnit]으로 Larva변태 시킵니다.
 * @param.epd.ko-KR
 * 변태할 유닛입니다.
 * @param.newUnit.ko-KR
 * 태어날 유닛입니다.
 *
 * @Summary.en-US
 * Morphs [epd] into [newUnit] via Larva.
 * @param.epd.en-US
 * The unit to morph.
 * @param.newUnit.en-US
 * The unit to spawn.
 *
 * @Summary.zh-CN
 * 将 [epd] 通过幼虫形态转变为 [newUnit]。
 * @param.epd.zh-CN
 * 要变形的单位。
 * @param.newUnit.zh-CN
 * 化形后的单位。
***/
function MorphLarvaEPD(epd, newUnit: TrgUnit) {
    if (MemoryXEPD(epd + 0x64/4, Exactly, 35, 0xFFFF)) {
        SetMemoryXEPD(epd + 0x4D/4, SetTo, 42 << 8, 0xFFFF00);
        SetMemoryXEPD(epd + 0x98/4, SetTo, newUnit, 0xFFFF);
    }
}

